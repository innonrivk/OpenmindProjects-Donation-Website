## Part 4: CI/CD Pipeline

### GitHub Actions Workflow

#### Workflow 1: API Tests (on every push/PR)

**File**: `.github/workflows/api-tests.yml`

```yaml
name: API Tests
on: [push, pull_request]

jobs:
  test:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: omp_user
          POSTGRES_PASSWORD: omp_dev_password
          POSTGRES_DB: omp_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 20 }
      - run: cd server && npm ci
      - run: cd server && npx prisma generate
      - run: cd server && npx prisma db push
      - run: cd server && node tests/run.js
        env:
          NODE_ENV: test
          DATABASE_URL: postgresql://omp_user:omp_dev_password@localhost:5432/omp_test
          JWT_SECRET: test-secret
          STRIPE_SECRET_KEY: ${{ secrets.STRIPE_TEST_SECRET_KEY }}
```

#### Workflow 2: E2E Tests (nightly / on-demand)

**File**: `.github/workflows/e2e-tests.yml`

```yaml
name: E2E Tests
on:
  schedule:
    - cron: '0 2 * * *'  # 2 AM UTC daily
  workflow_dispatch:       # Manual trigger

jobs:
  e2e:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: omp_user
          POSTGRES_PASSWORD: omp_dev_password
          POSTGRES_DB: omp_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: 20 }
      - run: cd server && npm ci
      - run: cd client && npm ci
      - run: npx playwright install --with-deps chromium
      - run: cd server && npx prisma generate && npx prisma migrate reset --force
        env:
          DATABASE_URL: postgresql://omp_user:omp_dev_password@localhost:5432/omp_test
      - run: cd server && node src/index.js &
        env:
          DATABASE_URL: postgresql://omp_user:omp_dev_password@localhost:5432/omp_test
      - run: cd client && npm run dev &
      - run: npx wait-on http://localhost:5173 http://localhost:3001/api/v1/health
      - run: cd client && npx playwright test
        env:
          TEST_GOOGLE_EMAIL: ${{ secrets.TEST_GOOGLE_EMAIL }}
          TEST_GOOGLE_PASSWORD: ${{ secrets.TEST_GOOGLE_PASSWORD }}
          STRIPE_SECRET_KEY: ${{ secrets.STRIPE_TEST_SECRET_KEY }}
          DATABASE_URL: postgresql://omp_user:omp_dev_password@localhost:5432/omp_test
      - uses: actions/upload-artifact@v4
        if: failure()
        with:
          name: playwright-report
          path: client/playwright-report/
```

