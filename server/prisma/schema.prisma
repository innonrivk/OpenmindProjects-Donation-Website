generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DONOR
  ADMIN
  CONTENT_ADMIN
  OPERATIONS_ADMIN
  SUPER_ADMIN
  SYSADMIN
}

enum TransactionStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
}

enum PiggyBankType {
  DONOR_SEED
  SHAREHOLDER_CAMPAIGN
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  password           String?
  googleId           String?             @unique @map("google_id")
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  country            String              @default("")
  role               UserRole            @default(DONOR)
  tokenVersion       Int                 @default(0) @map("token_version")
  stripeCustomerId   String?             @unique @map("stripe_customer_id")
  monthlyAmount      Int                 @default(0) @map("monthly_amount")
  isActive           Boolean             @default(true) @map("is_active")
  isProtected        Boolean             @default(false) @map("is_protected")
  scheduledAmount    Int?                @map("scheduled_amount")
  scheduledAmountEffectiveDate DateTime? @map("scheduled_amount_effective_date")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  transactions       Transaction[]
  votes              Vote[]
  claimedMilestones  ClaimedMilestone[]
  userTiers               UserTier[]
  internalNotifications   InternalNotification[]

  @@map("users")
}

model Transaction {
  id                     String            @id @default(uuid())
  userId                 String            @map("user_id")
  stripePaymentIntentId  String?           @unique @map("stripe_payment_intent_id")
  stripeInvoiceId        String?           @unique @map("stripe_invoice_id")
  amount                 Int               // in cents
  status                 TransactionStatus @default(SUCCEEDED)
  isRecurring            Boolean           @default(true) @map("is_recurring")
  subject                String?
  adminNote              String?           @map("admin_note")
  createdAt              DateTime          @default(now()) @map("created_at")
  user                   User              @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@map("transactions")
}

model ReceiptSettings {
  id                   Int      @id @default(autoincrement())
  donationType         String   @unique @default("GLOBAL") @map("donation_type")
  // "GLOBAL" | "ONE_TIME" | "RECURRING" | "TIER_{tierId}"
  emailSubjectTemplate String   @default("Thank you for your donation — Official OMP Receipt 🎉") @map("email_subject_template")
  // Supports: {donorName}, {amount}, {tierName}, {date}, {transactionId}, {transactionSubject}, {country}
  pdfThankYouMessage   String   @default("We appreciate your generous support.") @map("pdf_thank_you_message")
  pdfFooterNote        String   @default("This PDF is your official donation receipt. Please retain for your records.") @map("pdf_footer_note")
  pdfSignatureName     String   @default("The OpenmindProjects Team") @map("pdf_signature_name")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("receipt_settings")
}

model Tier {
  id                  Int           @id @default(autoincrement())
  tierLevel           Int           @map("tier_level")
  name                String
  minAmount           Int           @map("min_amount") // in dollars
  maxAmount           Int?          @map("max_amount") // null = unlimited
  isAutoAppliedBySum  Boolean       @default(false) @map("is_auto_applied_by_sum")
  perks               Json          @default("[]")
  donationBoxes       DonationBox[]
  userTiers           UserTier[]

  @@map("tiers")
}

model DonationBox {
  id             Int     @id @default(autoincrement())
  title          String
  amount         Int     @default(0) // monthly amount in dollars
  tierId         Int?    @map("tier_id")
  tierDetails    String  @default("") @map("tier_details")
  buttonText     String  @default("Donate") @map("button_text")
  isCustomAmount Boolean @default(false) @map("is_custom_amount")
  isRecurring    Boolean @default(true) @map("is_recurring")
  isActive       Boolean @default(true) @map("is_active")
  displayOrder   Int     @default(0) @map("display_order")
  perks          Json    @default("[]")
  tier           Tier?   @relation(fields: [tierId], references: [id])

  @@index([tierId])
  @@map("donation_boxes")
}

model WebsiteContent {
  id        Int      @id @default(autoincrement())
  head      String   @default("")
  subtitle  String   @default("")
  body      String   @default("")
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("website_content")
}

model ProjectDetail {
  id           Int           @id @default(autoincrement())
  projectName  String        @map("project_name")
  details      String        @default("")
  status       ProjectStatus @default(ACTIVE)
  imageUrl     String?       @map("image_url")
  fundingGoal  Int           @default(0) @map("funding_goal")  // in cents
  fundedAmount Int           @default(0) @map("funded_amount") // in cents
  piggyBanks   PiggyBank[]
  votes        Vote[]

  @@map("projects_detail")
}

model PiggyBank {
  id          Int           @id @default(autoincrement())
  bankType    PiggyBankType @map("bank_type")
  projectId   Int?          @map("project_id")
  balance     Int           @default(0) // in cents
  periodMonth DateTime      @map("period_month")
  project     ProjectDetail? @relation(fields: [projectId], references: [id])
  votes       Vote[]

  @@index([projectId])
  @@map("piggy_banks")
}

model Vote {
  id          Int           @id @default(autoincrement())
  userId      String        @map("user_id")
  projectId   Int           @map("project_id")
  piggyBankId Int           @map("piggy_bank_id")
  seedCount   Int           @default(1) @map("seed_count")
  createdAt   DateTime      @default(now()) @map("created_at")
  user        User          @relation(fields: [userId], references: [id])
  project     ProjectDetail @relation(fields: [projectId], references: [id])
  piggyBank   PiggyBank     @relation(fields: [piggyBankId], references: [id])

  @@index([projectId])
  @@index([piggyBankId])
  @@map("votes")
}

model DonationMilestone {
  id           Int                @id @default(autoincrement())
  amountUsd    Int                @map("amount_usd")
  label        String
  description  String
  isRepeatable Boolean            @default(false) @map("is_repeatable")
  displayOrder Int                @default(0) @map("display_order")
  claimedBy    ClaimedMilestone[]

  @@map("donation_milestones")
}

model ClaimedMilestone {
  id          Int               @id @default(autoincrement())
  userId      String            @map("user_id")
  milestoneId Int               @map("milestone_id")
  claimedAt   DateTime          @default(now()) @map("claimed_at")
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone   DonationMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([userId, milestoneId])
  @@map("claimed_milestones")
}

model UserOtp {
  id        String   @id @default(uuid())
  email     String
  otp       String   // Stored as bcrypt hash
  purpose   String   // 'REGISTRATION' | 'PASSWORD_CHANGE' | 'EMAIL_CHANGE'
  newEmail  String?  @map("new_email")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_otps")
}

enum SectionIdentifier {
  WELCOME
  ACTIVE_PROJECTS
  DONATION_BOXES
  DONATION_TIERS
  DONATION_ROADMAP
  TANGIBLE_IMPACT
  FOOTER
}

model SiteText {
  id        String            @id @default(uuid())
  key       String            @unique
  value     String
  section   SectionIdentifier
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([section])
  @@map("site_text")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  actorId      String   @map("actor_id")
  targetUserId String?  @map("target_user_id")
  action       String
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([targetUserId])
  @@index([actorId])
  @@map("audit_logs")
}

model AllowedAdminEmail {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("allowed_admin_emails")
}
model UserTier {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  tierId     Int      @map("tier_id")
  assignedBy String   @default("MANUAL") // 'MANUAL' or 'AUTO_SUM'
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier       Tier     @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([userId, tierId])
  @@index([userId])
  @@index([tierId])
  @@map("user_tiers")
}

model EmailTemplate {
  id           Int                 @id @default(autoincrement())
  name         String              @unique
  subject      String
  bodyHtml     String              @map("body_html")
  pdfConfig    Json?               @map("pdf_config")
  isArchived   Boolean             @default(false) @map("is_archived")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  triggers     AutomationTrigger[]
  dispatchLogs DispatchLog[]

  @@map("email_templates")
}

model AutomationTrigger {
  id              Int                   @id @default(autoincrement())
  eventName       String                @map("event_name")
  tierId          Int?                  @map("tier_id")
  emailTemplateId Int                   @map("email_template_id")
  isActive        Boolean               @default(true) @map("is_active")
  createdAt       DateTime              @default(now()) @map("created_at")

  template         EmailTemplate         @relation(fields: [emailTemplateId], references: [id])
  adminAssignments AdminRoleAssignment[]

  @@unique([eventName, tierId])
  @@map("automation_triggers")
}

model AdminRoleAssignment {
  id                  Int               @id @default(autoincrement())
  automationTriggerId Int               @map("automation_trigger_id")
  role                UserRole

  trigger AutomationTrigger @relation(fields: [automationTriggerId], references: [id], onDelete: Cascade)

  @@unique([automationTriggerId, role])
  @@map("admin_role_assignments")
}

model DispatchLog {
  id              Int           @id @default(autoincrement())
  emailTemplateId Int           @map("email_template_id")
  triggeredBy     String        @map("triggered_by")
  recipientCount  Int           @default(0) @map("recipient_count")
  status          String        @default("QUEUED")
  errorMessage    String?       @map("error_message")
  createdAt       DateTime      @default(now()) @map("created_at")

  template EmailTemplate @relation(fields: [emailTemplateId], references: [id])

  @@index([emailTemplateId])
  @@map("dispatch_logs")
}

model InternalNotification {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("internal_notifications")
}
