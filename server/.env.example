# Database
DATABASE_URL="postgresql://omp_user:omp_dev_password@localhost:5432/omp_database"
POSTGRES_PASSWORD="omp_dev_password"

# JWT Secrets
JWT_SECRET="dev-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production"
ADMIN_JWT_SECRET="dev-admin-secret-change-in-production"

# Server
PORT=3001
CLIENT_URL="http://localhost:5173"
ADMIN_URL="http://localhost:5174"

# Google OAuth (server-side verification)
GOOGLE_CLIENT_ID="your-google-client-id"

# SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Your Name <your-email@example.com>"

# Stripe (mock mode — leave as-is for local dev)
STRIPE_SECRET_KEY="sk_test_replace_with_your_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_your_webhook_secret"

# Optional
# REDIS_URL="redis://localhost:6379"
# SENDGRID_API_KEY="your-sendgrid-key"
